# ========================================================
# PROCUREPRIME B2B BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Cổng khởi chạy máy chủ Express
PORT=5000

# Địa chỉ Frontend (CORS whitelist)
FRONTEND_URL=http://localhost:5173

# Kết nối cơ sở dữ liệu MongoDB (Bắt buộc)
MONGO_URI=mongodb://127.0.0.1:27017/procureprime

# Khóa bảo mật JSON Web Token (Bắt buộc)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_min_32_characters
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_min_32_characters

# Redis Cache & Message Broker (Dùng cho Session chat AI & Cart cache)
REDIS_URL=redis://127.0.0.1:6379

# Google Gemini AI API Key (Dùng cho AI Procurement Copilot & Intent Router)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Cổng thanh toán VNPay Sandbox (B2B Checkout & Deposit)
VNP_TMNCODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment-result
VNP_API=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Cấu hình Gửi Email thông báo (Nodemailer - Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Dịch vụ Lưu trữ Hình ảnh Cloudinary (Tải lên ảnh sản phẩm/thiết bị B2B)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cổng thanh toán MoMo (Tùy chọn)
MOMO_PARTNER_CODE=MOMO_TEST
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

